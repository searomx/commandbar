{
  "name": "commandbar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint app lib components scripts tests prisma7.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node --conditions=react-server --import tsx --test tests/integration.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "prisma generate --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "use-mask-input": "^3.14.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "mailparser": "^3.14.3",
    "pdf-parse": "^2.4.5",
    "prisma": "^8.0.0-rc.33",
    "smtp-server": "^3.21.4",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
