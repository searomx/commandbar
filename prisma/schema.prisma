// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ROLES {
  USER
  ADMIN
  MANAGER
}
model User {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(30)
  email String @unique @db.VarChar(50)
  password String @db.VarChar(254)
  role  ROLES
  sessions Session[]
}
model Customer{
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(30)
  phone String? @db.VarChar(20)
  image String? @db.VarChar(255)
  orders Order[]
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}
model Categories {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(50)
  products Product[]
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}
model Groups {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(50)
  products Product[]
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}
model Product {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(50)
  categoryId Int
  category   Categories @relation(fields: [categoryId], references: [id])
  groupId Int
  group   Groups @relation(fields: [groupId], references: [id])
  description String @db.VarChar(255)
  unit  String @db.VarChar(15)
  price Decimal @db.Decimal(10, 2)
  mark  String @db.VarChar(50)
  stockAmount Decimal @db.Decimal(10, 2)
  orderItems OrderItem[]
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model Order {
  id    Int    @id @default(autoincrement())
  customerId Int
  totalAmount Decimal @db.Decimal(10, 2)
  items OrderItem[]
  customer Customer @relation(fields: [customerId], references: [id])
  paymentStatus       PaymentStatus @default(PENDING)
  paymentDate DateTime?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
  state OrderState @default(OPEN)
  paymentMethod PaymentMethod?
  shiftId Int?
  shift Shift? @relation("OpenedOrders", fields: [shiftId], references: [id])
  paymentShiftId Int?
  paymentShift Shift? @relation("PaidOrders", fields: [paymentShiftId], references: [id])
  @@index([paymentStatus, paymentShiftId])
}
model OrderItem {
  id       Int     @id @default(autoincrement())
  orderId  Int
  order   Order   @relation(fields: [orderId], references: [id])
  productId Int
  product  Product @relation(fields: [productId], references: [id])
  quantity Decimal @db.Decimal(10, 2)
  unit     String  @db.VarChar(15)
  price    Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderState {
  OPEN
  CHECKOUT
  PAID
}

enum PaymentMethod {
  PIX
  CASH
  CARD
}

model Shift {
  id Int @id @default(autoincrement())
  openKey Int? @unique
  openedAt DateTime @default(now())
  closedAt DateTime?
  openedBy Int
  closedBy Int?
  orders Order[] @relation("OpenedOrders")
  paidOrders Order[] @relation("PaidOrders")
}

model Session {
  tokenHash String @id
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}

model LoginAttempt {
  key String @id
  attempts Int @default(0)
  startedAt DateTime @default(now())
  blockedUntil DateTime?
}
